[submodule ".registry"]
	path = .registry
	url = https://github.com/marcburri/marcburri.r-universe.dev
	branch = HEAD
[submodule "bridgr"]
	path = bridgr
	url = https://github.com/marcburri/bridgr
	branch = v1.0.0
[submodule "hetiv"]
	path = hetiv
	url = https://github.com/dankaufmann/hetiv
	branch = main
[submodule "reviser"]
	path = reviser
	url = https://github.com/ropensci/reviser
	branch = v0.2.0
